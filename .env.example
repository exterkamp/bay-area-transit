# Copied to .env by scripts/bootstrap.sh, which fills in the secret key.
# Passwords and the 511 API key live in secrets/, not here.

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# For when this is published, e.g. https://transit.exterkamp.codes
DJANGO_CSRF_TRUSTED_ORIGINS=

# Host ports (bound to 127.0.0.1 only).
WEB_PORT=8086
API_PORT=8087

# 511 operators to import (about one request a day each), and to poll
# realtime for. Realtime costs 46 requests/hour per operator at the default
# intervals; 511 allows 60/hour.
TRANSIT_OPERATORS=RG
TRANSIT_REALTIME_OPERATORS=RG
# Agencies kept from the regional (RG) feed: Muni rail only, BART, SamTrans,
# Caltrain. "SF:0+5" would add the cable cars.
TRANSIT_RG_AGENCIES=SF:0,BA,SM,CT
TRANSIT_POLL_TRIP_UPDATES=180
TRANSIT_POLL_VEHICLE_POSITIONS=180
TRANSIT_POLL_ALERTS=600
TRANSIT_STATIC_REFRESH_HOURS=24

# This host has buildx 0.10; compose >=2.40 wants 0.17 for its bake builder.
COMPOSE_BAKE=false
